{
    "name": "pandoras-box",
    "version": "1.1.2",
    "description": "A small and simple stress testing tool for Ethereum-compatible blockchain networks",
    "main": "./bin/index.js",
    "types": "./bin/index.d.ts",
    "author": "Milos Zivkovic (zivkovicmilos)",
    "engines": {
        "node": ">=22.19.0",
        "yarn": ">=1.22.0"
    },
    "license": "Apache-2.0",
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/cli-progress": "^3.11.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.1.0",
        "@types/pg": "^8.11.6",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "globals": "^15.0.0",
        "jest": "^29.7.0",
        "prettier": "3.2.5",
        "ts-jest": "^29.2.3",
        "typescript": "^5.9.2"
    },
    "scripts": {
        "tsc": "tsc",
        "lint": "eslint '**/*.ts' --fix",
        "prettier": "prettier --write .",
        "build": "yarn tsc && yarn chmod",
        "chmod": "chmod u+x ./bin/index.js",
        "prepare": "yarn build",
        "prepublishOnly": "yarn lint && yarn prettier",
        "get-pending": "node bin/tools/getPendingCount.js",
        "listeners": "node bin/tools/crossChainListeners.js",
        "run:deposit": "npx ts-node src/runtime/deposit.ts",
        "test": "jest"
    },
    "bin": {
        "pandoras-box": "./bin/index.js"
    },
    "keywords": [
        "pandora",
        "pandoras box",
        "pandoras-box",
        "ethereum",
        "stress test"
    ],
    "dependencies": {
        "@ethersproject/contracts": "^5.7.0",
        "@ethersproject/providers": "^5.7.2",
        "@ethersproject/units": "^5.7.0",
        "@ethersproject/wallet": "^5.7.0",
        "@types/cli-table": "^0.3.1",
        "@types/heap": "^0.2.31",
        "axios": "^1.2.1",
        "bitcoinjs-lib": "^6.1.5",
        "bs58check": "^4.0.0",
        "chalk": "4.1.2",
        "cli-progress": "^3.12.0",
        "cli-table3": "^0.6.3",
        "commander": "^12.0.0",
        "dotenv": "^16.4.5",
        "ecpair": "^3.0.0",
        "ethers": "^6.15.0",
        "fs": "^0.0.1-security",
        "heap": "^0.2.7",
        "pg": "^8.12.0",
        "tiny-secp256k1": "^2.2.4",
        "sqlite": "^5.1.1",
        "sqlite3": "^5.1.7",
        "zeromq": "^6.5.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/madz-lab/pandoras-box.git"
    },
    "homepage": "https://docs.madz-lab.com/pandoras-box",
    "files": [
        "bin/**/*"
    ],
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
